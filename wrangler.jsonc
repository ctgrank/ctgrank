{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ctgrank",
  "compatibility_date": "2026-10-31",
  // This project exists only to redirect the old
  // ctgrank.jahinhashemchowdhury.workers.dev address at the edge with a
  // real 301, preserving path + query.
  //
  // Cloudflare Pages (the live site) reads _redirects/_headers and IGNORES
  // this file, so both projects build from main without interfering.
  "main": "tools/redirect-worker.js"
}
